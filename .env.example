# ==============================================================================
# 📦 Linux Service Deployer - 全域版本與服務設定檔
# ==============================================================================
# 複製此檔案為 .env 即可生效：cp .env.example .env
# 所有 Docker 服務版本號與連線密碼均在此統一管理，YAML 檔案無需修改！

# ------------------------------------------------------------------------------
# 1. 網路與代理 (Nginx)
# ------------------------------------------------------------------------------
NGINX_VERSION=1.26-alpine
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ------------------------------------------------------------------------------
# 2. 高效快取庫 (Redis)
# ------------------------------------------------------------------------------
REDIS_VERSION=7.4-alpine
REDIS_PORT=6379
REDIS_PASSWORD=MySecureRedisPass123!
REDISINSIGHT_VERSION=latest
REDISINSIGHT_PORT=5540

# ------------------------------------------------------------------------------
# 3. 關聯式資料庫 (PostgreSQL + pgAdmin4)
# ------------------------------------------------------------------------------
POSTGRES_VERSION=16-alpine
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=MySecurePgPass123!
POSTGRES_DB=app_db
PGADMIN_VERSION=latest
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin

# ------------------------------------------------------------------------------
# 4. 文件式資料庫 (MongoDB + Mongo Express)
# ------------------------------------------------------------------------------
MONGO_VERSION=7.0
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=mongoadmin
MONGO_INITDB_ROOT_PASSWORD=MySecureMongoPass123!
MONGO_EXPRESS_VERSION=latest
MONGO_EXPRESS_PORT=8081
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=admin

# ------------------------------------------------------------------------------
# 5. 集中式日誌管理平台 (Graylog 6.0 + OpenSearch 2.15 + MongoDB)
# ------------------------------------------------------------------------------
GRAYLOG_VERSION=6.0
GRAYLOG_PORT=9000
OPENSEARCH_VERSION=2.15.0
# 請執行 pwgen -N 1 -s 96 產生至少 64 字元的 secret
GRAYLOG_PASSWORD_SECRET=16CharsOrMoreSecretStringForGraylogTokenEncryptKey123456
# 預設管理員密碼 hash (echo -n "admin" | sha256sum)
GRAYLOG_ROOT_PASSWORD_SHA2=8c6976e5b5410415bde908bd4dee15dfb167a9c873fc4bb8a81f6f2ab448a918

# ------------------------------------------------------------------------------
# 6. 巨量搜尋與日誌分析堆疊 (ELK: Elasticsearch + Kibana 8.x)
# ------------------------------------------------------------------------------
ELK_VERSION=8.15.0
ELASTIC_PORT=9200
KIBANA_PORT=5601
ELASTIC_PASSWORD=MySecureElasticPass123!
ES_JAVA_MEM_LIMIT=1g
